{%- schema -%}
{
  "name": "Service Calls",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Select your subscription"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe the feature.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service Calls",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{%- endschema -%}

 <div class="max-w-7xl mx-auto mt-25 mb-25">
    {% if section.settings.heading != blank %}
      <h3 class="mb-12 max-w-max mx-auto color-black text-center text-lg md:text-xl lg:text-2xl uppercase">{{ section.settings.heading }}</h3>
    {% endif %}

    {% for block in section.blocks %}
      {%- case block.type -%}

      {{ block.settings.title }}

      {{ block.settings.text }}
        {%- when 'subscription' -%}
          <div class="grid grid-cols-1 md:grid-cols-2 grid-rows-1 gap-4">
            <div clas="rounded-2xl">
              {{ block.shopify_attributes }}>
              {% if block.settings.text != blank %}
              <div class="text-2xl font-bold uppercase text-black pb-6">
              {{ block.settings.title }}
              </div>
              <div class=" text-base">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </div>
      {%- endcase -%}
    {% endfor %}
  </div>
