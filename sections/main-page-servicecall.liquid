{%- schema -%}
{
  "name": "Service Calls",
  "settings": [
  ],
  "blocks": [
    {
      "type": "subscription",
      "name": "Subscriptions",
      "settings": [
        { "type": "text", "id": "heading","label": "Heading"},
        { "type": "richtext", "id": "text","label": "Text", "default": "<p>Describe the feature.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service Calls",
      "blocks": [
        { "type": "subscription"  },
      ]
    }
  ]
}
{%- endschema -%}

 <div class="max-w-7xl mx-auto mt-25 mb-25">
   {% if section.settings.heading != blank %}
     <h3 class="mb-12 max-w-max mx-auto color-black text-center text-lg md:text-xl lg:text-2xl uppercase">{{ section.settings.heading }}</h3>
   {% endif %}

  <div class="grid grid-cols-1 md:grid-cols-2 grid-rows-1 gap-4">

    <div class="rounded-2xl bg-grey-500"> chris
<h4>{{ block.settings.heading }}</h4>
      {% if block.settings.heading %}
      <h4>{{ block.settings.heading }}</h4>
      {% endif %}

    </div>

    {% for block in section.blocks %}
          <div class="rounded-2xl bg-gray-500">

            {{ block.settings.heading }}heading

            {{ block.settings.text }}list items
            <div>
              {% if block.settings.heading != blank %}
              {{ block.settings.heading }}
              {% endif %}
              {% if block.settings.text != blank %}
              {{ block.settings.text }}
              {% endif %}
            </div>
          </div>
      {% endfor %}


  </div>
</div>


