{% schema %}
{
  "name": "Main Collection Section",
  "class": "section-main-collection",
  "tag": "section"
}
{% endschema %}


<div class='px-6 md:px-8 py-12 mt-50 max-w-5xl mx-auto items-center'>
  <h2 class='mb-12 max-w-max mx-auto color-black text-center text-lg md:text-xl lg:text-2xl'>
    {{ collection.title }}
  </h2>
    <p class="text-lg text-center">{{ collection.description }}</p>
</div>

<div class='px-6 md:px-8 py-12 max-w-6xl mx-auto items-center'>

      {%- paginate collection.products by 12 -%}
        <div class='product-grid grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-4 mx-auto'>
          {% for prod in collection.products %}
            {% render 'product-grid-item', prod: prod %}
          {% endfor %}
        </div>

        <div class='mt-10 [&_.pagination]:mx-auto [&_.pagination]:flex [&_.pagination]:max-w-max [&_.pagination]:gap-2.5'>
          {% render 'pagination-navigation', paginate: paginate %}
        </div>
      {% endpaginate %}
    </div>

</div>
