<!-- section 1 -->
<div
 x-data="{ isVisible: false }"
 x-intersect.once="isVisible = true"
 class="relative isolate overflow-hidden bg-white py-24 sm:py-32 transform transition-all duration-1500 ease-in-out"
 :class="isVisible ? 'opacity-100' : 'opacity-0'"
 >
  <div class="mx-auto max-w-full md:px-6 lg:pl-8 lg:pr-0">
    <div class="grid grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:grid-cols-2 items-center">
      <div class="px-6 md:px-0 lg:pt-4 lg:px-20">
        <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-3xl">
        {% if section.settings.section_subtitle != blank %}
          <h2 class="text-xl font-bold text-gold-600">
            {{ section.settings.section_subtitle }}
          </h2>
        {% endif %}

        {% if section.settings.main_heading != blank %}
          <h3 class="mt-5 text-2xl font-bold tracking-tight text-pretty text-gray-900 sm:text-xl md:text-2xl lg:text-3xl">
            {{ section.settings.main_heading }}
          </h3>
        {% endif %}
        {% if section.settings.section_description != blank %}
          <p class="mt-6 text-base text-gray-700">
            {{ section.settings.section_description }}
          </p>
        {% endif %}
        </div>
      </div>
      <div class="sm:px-6 lg:px-0">
        <div class="relative isolate overflow-hidden bg-white sm:mx-auto sm:max-w-2xl rounded-3xl sm:shadow-md lg:shadow-xl/30 lg:mx-0 lg:max-w-none -right-24">
          {% if section.settings.about_us_img != blank %}
              <img src="{{ section.settings.about_us_img | image_url: width: 800 }}" alt="about-image" class="magniflier w-800 right-96" loading="lazy">
              {% else %}
              <div class="overflow-hidden" style="--ratio-percent: 78.576%">
                {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- section 2 -->
<div
  x-data="{ isVisible: false }"
  x-intersect.threshold.50="isVisible = true"
  class="grid grid-cols-1 md:grid-cols-2 grid-rows-1 gap-4 h-175 items-center bg-gray-100 transform transition-all duration-1500 delay-500 ease-in-out"
  :class="isVisible ? 'opacity-100 scale-100' : 'opacity-10 scale-93'"
  >
    <div >
      {% if section.settings.about_us_img2 != blank %}
        <img src="{{ section.settings.about_us_img2 | image_url: width: 800 }}" alt="about-image" class="magniflier w-800 right-96" loading="lazy">
      {% else %}
         <div class="overflow-hidden" style="--ratio-percent: 78.576%">
            {{ 'collection-6' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
          </div>
      {% endif %}
    </div>
    <div >
      {% if section.settings.content != blank %}
        <p class="my-4 px-8 lg:px-16 text-base text-gray-700 text-center">
          {{ section.settings.content }}
        </p>
      {% endif %}

      {% if section.settings.about-btn-text != blank %}
      <p class="text-center">
        <a href="{{ section.settings.about-btn-url }}" class="mt-5 rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm font-semibold text-center text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:bg-gradient-to-r hover:from-gold-400 hover:via-gold-200 hover:to-gold-400 transition delay-150">
          {{ section.settings.about-btn-text }}&nbsp;<span aria-hidden="true">→</span>
        </a>
        </p>
      {% endif %}
    </div>
</div>


{% schema %}
  {
    "name": "Aboutus section",
    "tag": "section",
    "class": "section aboutus_section",
    "settings": [
      {
        "type": "header",
        "content": "Heading One"
      },
      {
        "type": "text",
        "id": "section_subtitle",
        "label": "Subheading",
        "default": "About your brand"
      },
      {
        "type": "textarea",
        "id": "main_heading",
        "label": "Heading",
        "default": "About us"
      },
      {
        "type": "textarea",
        "id": "section_description",
        "default": "Pair text with an image to focus on your chosen product, collection, or about us content.",
        "label": "Section One Body Copy"
      },
      {
        "type": "image_picker",
        "id": "about_us_img",
        "label": "First Image"
      },
      {
        "type": "header",
        "content": "Second part setting"
      },
      {
        "type": "image_picker",
        "id": "about_us_img2",
        "label": "Section Section Image"
      },
      {
        "type": "textarea",
        "id": "content",
        "default": "Sit amet volutpat consequat mauris nunc congue nisi vitae suscipit. At auctor urna nunc id cursus metus. Purus sit amet luctus venenatis lectus magna. Rhoncus aenean vel elit scelerisque mauris.",
        "label": "Second Section Content"
      },
      {
        "type": "text",
        "id": "about-btn-text",
        "label": "Button",
        "default": "Explore Equipment"
      },
      {
        "type": "url",
        "id": "about-btn-url",
        "label": "Button link"
      },
      {
        "type": "header",
        "content": "Color settings"
      }
    ],
     "presets": [
      {
        "name": "Aboutus section"
      }
    ]
  }
{% endschema %}