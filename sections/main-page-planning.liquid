{%- schema -%}
{
  "name": "Planning Section",
  "class": "section-main-planning",
  "tag": "section",
  "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "body",
        "label": "Inline rich text"
      },
      {
        "type": "text",
        "id": "contact_btn_text",
        "default": "Contact Us",
        "label": "Button text"
      },
      {
        "type": "url",
        "id": "contact_btn_link",
        "label": "Button link"
      },
    ],
    "presets": [
      {
        "name": "Custom Section"
      }
    ]
  }
{%- endschema -%}

<div class='bg-white px-6 md:px-8 py-12 mx-auto max-w-5/8'>
  <div class='container'>
    <div class="max-w-7xl mx-auto mb-25 divide-y divide-outline overflow-hidden rounded-radius rounded-md border border-gold-400 border-outline bg-surface-alt/40 text-on-surface dark:divide-outline-dark dark:border-outline-dark dark:bg-surface-dark-alt/50 dark:text-on-surface-dark">
      {%- for block in section.blocks -%}
        {% if section.settings.open_first_collapsible_row and forloop.first %}
          <div x-data="{ isExpanded: false }">
            <button id="controlsAccordionItem{{ block.settings.content_number }}" type="button" class="flex w-full items-center justify-between gap-4 bg-surface-alt p-4 text-center underline-offset-2 hover:bg-surface-alt/75 focus-visible:bg-surface-alt/75 focus-visible:underline focus-visible:outline-hidden dark:bg-surface-dark-alt dark:hover:bg-surface-dark-alt/75 dark:focus-visible:bg-surface-dark-alt/75" aria-controls="accordionItemOne" x-on:click="isExpanded = ! isExpanded" x-bind:class="isExpanded ? 'text-on-surface-strong dark:text-on-surface-dark-strong font-bold'  : 'text-on-surface dark:text-on-surface-dark font-medium'" x-bind:aria-expanded="isExpanded ? 'true' : 'false'">
              <div class="text-lg mr-10">
                {{ block.settings.content_number }}
              </div>
              {{ block.settings.heading }}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor" class="size-5 shrink-0 transition" aria-hidden="true" x-bind:class="isExpanded  ?  'rotate-180'  :  ''">
                   <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
            </button>
              <div x-cloak x-show="isExpanded" id="accordionItem{{ block.settings.content_number }}" role="region" aria-labelledby="controlsAccordionItemOne" x-collapse>
                <div class="p-4 text-sm sm:text-base text-pretty">
                    {{ block.settings.row_content }}
                </div>
            </div>
            </div>
          {% else %}
          <div x-data="{ isExpanded: false }">
            <button id="controlsAccordionItem{{ block.settings.content_number }}" type="button" class="flex w-full items-center justify-between gap-4 bg-surface-alt p-4" aria-controls="accordionItem{{ block.settings.content_number }}" x-on:click="isExpanded = ! isExpanded" x-bind:class="isExpanded ? 'text-on-surface-strong dark:text-on-surface-dark-strong font-bold'  : 'text-on-surface dark:text-on-surface-dark font-medium'" x-bind:aria-expanded="isExpanded ? 'true' : 'false'">
              <div class="text-lg mr-10">
                {{ block.settings.content_number }}
              </div>
              {{ block.settings.heading }}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor" class="size-5 shrink-0 transition" aria-hidden="true" x-bind:class="isExpanded  ?  'rotate-180'  :  ''">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
              </svg>
            </button>
              <div x-cloak x-show="isExpanded" id="accordionItem{{ block.settings.content_number }}" role="region" aria-labelledby="accordionItem{{ block.settings.content_number }}" x-collapse>
                <div class="p-4 mx-10 text-sm sm:text-base text-pretty">
                    {{ block.settings.row_content }}
                </div>
            </div>
            </div>
        {% endif %}
      {%- endfor -%}
    </div>

    <header>
      <h1 class="mb-12 max-w-max mx-auto color-black text-center text-lg md:text-xl lg:text-2xl uppercase">{{ page.title }}</h1>
      <div>
      <p class='mb-16 font-light text-center text-gray-500 sm:text-xl max-w-[700px] mx-auto'>{{ page.content }}</div>
    </header>
    <div class="max-w-7xl mx-auto px-1 md:px-8 mb-20 text-center">
      {% if section.settings.further_text != blank or section.settings.contact_btn_text != blank %}
        <p class="px-6 md:px-8 py-12 mx-auto text-center text-md">{{ section.settings.further_text }}</p>

        <a {% if section.settings.contact_btn_link %} href="{{ section.settings.contact_btn_link }}" {% else %} role="link" aria-disabled="true" {% endif %} class="mt-25 text-center rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:bg-gradient-to-r hover:from-gold-400 hover:via-gold-200 hover:to-gold-400 transition delay-150">{{ section.settings.contact_btn_text }}</a>
      {% endif %}
    </div>
  </div>
</div>