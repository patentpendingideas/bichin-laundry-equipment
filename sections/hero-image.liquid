<section class="relative w-full">
	<div
		x-data="{
			current: 0,
			slides: {{ section.blocks.size }},
			autoplay: {{ section.settings.autoplay | json }},
			interval: null,
			next() {
				this.current = (this.current + 1) % this.slides
			},
			prev() {
				this.current = (this.current - 1 + this.slides) % this.slides
			},
			goTo(i) {
				this.current = i
			},
			startAutoplay() {
				if (!this.autoplay) return
				this.interval = setInterval(() => this.next(), {{ section.settings.autoplay_speed | default: 5000 }})
			},
			stopAutoplay() {
				clearInterval(this.interval)
			}
		}"
		x-init="startAutoplay()"
		@mouseenter="stopAutoplay()"
		@mouseleave="startAutoplay()"
		class="relative max-w-full mx-auto overflow-hidden"
	>
		<!-- Slides track -->
		<div
			class="flex transition-transform duration-500 ease-out"
			:style="`transform: translateX(-${current * 100}%)`"
		>
			{% for block in section.blocks %}
				<div class="w-full flex-shrink-0" {{ block.shopify_attributes }}>
					<div class="relative aspect-[16/9] md:aspect-[21/9]">
						{% if block.settings.image %}

							<img src="{{ block.settings.image | image_url: width: 2800 }}" alt="{{ block.settings.image.alt | escape }}" class="absolute inset-0 h-full w-full object-cover">						loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
						{% else %}
							<div class="absolute inset-0 bg-gray-200 flex items-center justify-center text-gray-400">
								No image selected
							</div>
						{% endif %}


						{% if block.settings.title or block.settings.description %}
							<div class="absolute inset-0 bg-black/30 flex items-center">
								<div class="px-8 md:pl-32 max-w-2xl text-white">
									{% if block.settings.title != blank %}
										<h1 class="text-3xl text-sm/8 font-bold tracking-tight text-balance text-white sm:text-3xl md:text-5xl ">{{ block.settings.title }}</h1>
									{% endif %}
									{% if block.settings.description != blank %}
										<p class="my-6 text-md font-medium text-pretty text-white sm:text-xl/6">{{ block.settings.description }}</p>
									{% endif %}

									{% if block.settings.button_text != blank %}
										<a
											href="{{ block.settings.button_link | default: '#' }}"
											class="mt-15 rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:bg-gradient-to-r hover:from-gold-400 hover:via-gold-200 hover:to-gold-400 transition"
										>
											{{ block.settings.button_text }}&nbsp;<span aria-hidden="true">→</span>
										</a>
									{% endif %}
								</div>
							</div>
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>

		<!-- Prev / Next arrows -->
		{% if section.blocks.size > 1 %}
			<button
				@click="prev()"
				aria-label="Previous slide"
				class="absolute left-3 top-1/2 -translate-y-1/2 h-9 w-9 rounded-full bg-white/80 hover:bg-white shadow flex items-center justify-center transition"
			>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
				</svg>
			</button>
			<button
				@click="next()"
				aria-label="Next slide"
				class="absolute right-3 top-1/2 -translate-y-1/2 h-9 w-9 rounded-full bg-white/80 hover:bg-white shadow flex items-center justify-center transition"
			>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
				</svg>
			</button>

			<!-- Dots -->
			<div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
				{% for block in section.blocks %}
					<button
						@click="goTo({{ forloop.index0 }})"
						aria-label="Go to slide {{ forloop.index }}"
						class="h-2 rounded-full transition-all"
						:class="current === {{ forloop.index0 }} ? 'w-6 bg-white' : 'w-2 bg-white/50'"
					></button>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>

{% schema %}
{
	"name": "Bichin Hero Image Slider",
	"settings": [],
	"blocks": [
		{
			"type": "slide",
			"name": "Slide",
			"limit": 4,
			"settings": [
				{ "type": "image_picker", "id": "image", "label": "Image" },
				{ "type": "text", "id": "eyebrow", "label": "eybrow", "default": "Commercial Laundry Equipment" },
				{ "type": "text", "id": "title", "label": "Heading", "default": "Your Title" },
				{ "type": "textarea", "id": "description", "label": "Description", "default": "Description for Slide" },
				{ "type": "text", "id": "button_text", "label": "Button Text" },
				{ "type": "url", "id": "button_link", "label": "Button Link" }
			]
		}
	],
	"presets": [{ "name": "Bichin Hero Image Slider" }]
}
{% endschema %}
