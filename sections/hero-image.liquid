<div class="max-w-full mx-auto" x-data="{ activeSlide: 0, slides: 3 }">
	<!-- Slides Container -->
	<div class="relative isolate overflow-hidden shadow-lg h-5/8">
		<div class="flex transition-transform duration-505 ease-in-out" :style="'transform: translateX(-' + (activeSlide * 100) + '%)'">
			{%- for block in section.blocks -%}

				{%- if block.settings.image != blank -%}
					<img src="{{ block.settings.image | image_url: width: 2800 }}" alt="{{ block.settings.title }}" class="absolute inset-0 -z-10 size-full object-cover">
				{%- else -%}
					{{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-64 bg-slate-200 rounded-xl' }}
				{%- endif -%}

				<div class="mx-25 max-w-7xl px-6 lg:px-8">
					<div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-56">
						{% comment %} <div class="hidden sm:mb-8 sm:flex sm:justify-center">
						{%- if block.settings.eyebrow != blank -%}
							<p class="text-lg text-slate-600">{{ block.settings.eyebrow }}</p>
						{%- endif -%}
						</div> {% endcomment %}
						<div class="text-left bg-slateblue p-7 rounded-xl">
							{%- if block.settings.eyebrow != blank -%}
								<p class="text-lg text-white">{{ block.settings.eyebrow }}</p>
							{%- endif -%}
							<h1 class="text-3xl font-bold tracking-tight text-balance text-white sm:text-3xl md:text-5xl ">{{ block.settings.title }}</h1>
							<p class="mt-8 text-lg font-medium text-pretty text-white sm:text-xl/8">{{ block.settings.description }}</p>

							{%- if block.settings.button_text != blank -%}
								<button type="button" href="{{ block.settings.button_link }}" class="rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">{{ block.settings.button_text }}&nbsp;<span aria-hidden="true">→</span></button>
							{%- endif -%}
						</div>
					</div>
				</div>
			{%- endfor -%}
		</div>
		<!-- Navigation Buttons -->
		<button @click="activeSlide = (activeSlide === 0) ? slides - 1 : activeSlide - 1" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white p-3 rounded-full shadow transition">❮</button>
		<button @click="activeSlide = (activeSlide === slides - 1) ? 0 : activeSlide + 1" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white p-3 rounded-full shadow transition">❯</button>
	</div>
</div>

{% schema %}
{
	"name": "Bichin Hero Image Slider",
	"settings": [],
	"blocks": [
		{
			"type": "slide",
			"name": "Slide",
			"settings": [
				{ "type": "image_picker", "id": "image", "label": "Image" },
				{ "type": "text", "id": "eyebrow", "label": "eybrow", "default": "Commercial Laundry Equipment" },
				{ "type": "text", "id": "title", "label": "Heading", "default": "Your Title" },
				{ "type": "textarea", "id": "description", "label": "Description", "default": "Description for Slide" },
				{ "type": "text", "id": "button_text", "label": "Button Text" },
				{ "type": "url", "id": "button_link", "label": "Button Link" }
			]
		}
	],
	"presets": [{ "name": "Bichin Hero Image Slider" }]
}
{% endschema %}
