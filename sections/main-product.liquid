{% schema %}
{
  "name": "Product Section",
  "class": "section-main-product",
  "tag": "section",
  "settings": [
    {
      "type": "radio",
      "id": "picker_type",
      "label": "Variant Picker Type",
      "options": [
        {
          "value": "radio",
          "label": "Radio Buttons"
        },
        {
          "value": "select",
          "label": "Select Dropdowns"
        }
      ],
      "default": "radio"
    }
  ],
  "blocks": [
    {
      "type": "collapsable_row",
      "name": "Collapsable Row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ]
}
{% endschema %}

<div class='px-6 md:px-8 py-12'>
  <div
    class='shopify-section-main-product-inner container mx-auto'
    data-handle='{{ product.handle }}'
    data-id='{{ product.id }}'
    data-url='{{ product.url }}'
    data-section='{{ section.id }}'
    data-prodify='{{ section.settings.picker_type }}'
  >
    <script type='application/json' data-prodify-variants-json>
      {{ product.variants | json }}
    </script>

    <a
      class='absolute z-50 px-4 py-2 text-white bg-cloud-burst rounded-lg shadow-lg not-focus:sr-only'
      href='#product-info-{{ section.id }}'
    >
      Skip to product info
    </a>
    <div class='md:flex md:gap-12 pdp-main relative'>
      <div class='media flex-1 mb-8 md:mb-0' data-prodify-media-container>
        <div class='image-wrapper relative overflow-hidden pt-[137%]'>
          {% if product.selected_variant and product.selected_variant.image %}
            {% assign media = product.selected_variant.image %}
          {% else %}
            {% assign media = product.featured_image %}
          {% endif %}
          <img
            src='{{ media | image_url }}'
            alt='{{ media.alt }}'
            srcset='{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1426 }} 1426w'
            sizes='(min-width: 768px) 55vw, 100vw'
            height='{{ media.height }}'
            width='{{ media.width }}'
            class='absolute h-full w-full object-contain inset-0'
            loading='eager'
          >
        </div>

        {% comment %} <span class='absolute top-0 left-0 z-100 text-[10px]'>
          {{ product.selected_or_first_available_variant.id }}
        </span> {% endcomment %}

      </div>
      <div class='info flex-1 mt-40' id='product-info-{{ section.id }}'>
        <p class='caption tracking-wide text-[10px] leading-3 text-gray-500'>
          {{ product.type | upcase }}
        </p>
        <h1 class='text-3xl leading-normal font-medium'>{{ product.title }}</h1>
        {% comment %} <div class='flex items-center py-2' data-prodify-price-container>
          <span class='sr-only'>Regular Price</span>
          {% if product.selected_or_first_available_variant.compare_at_price %}
            <span class='line-through'>
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            </span>
          {% endif %}
          <span>
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
        </div> {% endcomment %}

        {% render 'product-variant-picker',
          product: product,
          product_form_id: 'product-form-id',
          picker_type: section.settings.picker_type
        %}

        <div class='description prose'>
         <p class="text-lg text-black"> {{ product.description }}</p>
        </div>

      {% comment %}
        If there is a specSheet MetaField, show it here
      {% endcomment %}

    {%- assign current_variant = product.selected_or_first_available_variant -%}
      {%- assign current_file_url = current_variant.metafields.global.specSheet.value.url -%}

    <div class="variant-file-container">
      <a id="variant-file-link"
        href="{{ current_file_url | default: '#' }}"
        target="_blank"
        class="rounded-md bg-white px-2.5 py-1 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 hover:text-gold-400 transition ease-in-out duration-500"
        style="display: {% if current_file_url %}inline-flex{% else %}none{% endif %};">
        <strong>Download Model Spec Sheet</strong>
      </a>
    </div>

    {% comment %} JSON map of variant IDs to spec sheet URLs {% endcomment %}
    <script id="variant-file-map" type="application/json">
      {
        {%- for variant in product.variants -%}
          "{{ variant.id }}": "{{ variant.metafields.global.specSheet.value.url | default: '' }}"
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
          const fileLink = document.getElementById('variant-file-link');
          const fileMapEl = document.getElementById('variant-file-map');

          if (!fileLink || !fileMapEl) return;

          const variantFileMap = JSON.parse(fileMapEl.textContent);

          function checkUrlForVariant() {
            const urlParams = new URLSearchParams(window.location.search);
            const variantId = urlParams.get('variant');

            if (variantId && variantFileMap[variantId]) {
              fileLink.href = variantFileMap[variantId];
              fileLink.style.display = 'inline-flex';
            } else {
              fileLink.href = '#';
              fileLink.style.display = 'none';
            }
          }

          // 1. Check immediately on page load
          checkUrlForVariant();

          // 2. Listen for URL changes if your theme uses pushState/replaceState
          let lastUrl = location.href;
          new MutationObserver(() => {
            if (location.href !== lastUrl) {
              lastUrl = location.href;
              // Small timeout ensures the theme's history states are finalized
              setTimeout(checkUrlForVariant, 50);
            }
          }).observe(document, { subtree: true, childList: true });
        });
    </script>


        {% comment %} <div class='quantity-row'>
          <label for='quantity-control-input'>Quantity</label>
          <div class='quantity-control-container'>
            <button type='button' data-prodify-quantity-decrement>
              {% render 'icon', icon: 'minus' %}
            </button>
            <input
              tabindex='-1'
              type='number'
              id='quantity-control-input'
              value='1'
              disabled=''
              data-prodify-quantity-presentation
            >
            <button type='button' data-prodify-quantity-increment>
              {% render 'icon', icon: 'plus' %}
            </button>
          </div>
        </div> {% endcomment %}

        <ajax-cart-product-form>
          <form
            action='{{ routes.cart_add_url }}'
            id='product_form_id'
            class='product-form mt-2'
            novalidate='novalidate'
            data-prodify-product-form
          >
            <input
              type='hidden'
              name='id'
              value='{{ product.selected_or_first_available_variant.id }}'
            >
            <input
              type='hidden'
              name='quantity'
              value='1'
              data-prodify-quantity-hidden-input
            >
            <div class='mb-2.5'>
              <!-- links for specific contact pages depending on category -->
              {% assign in_collection = false %}

              {% for collection in product.collections %}
                {% if collection.handle == 'dexter-laundry-equipment-parts' %}
                  {% assign in_collection = true %}
                  {% break %}
                {% endif %}
              {% endfor %}

              {% if in_collection %}
              <button
                type='submit'
                name='add'
                class='mt-1 rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:bg-gradient-to-r hover:from-gold-400 hover:via-gold-200 hover:to-gold-400 transition delay-150'
                {% if product.selected_or_first_available_variant.available == false %}
                  disabled
                {% endif %}
              >
                <span class='in-[[processing]]:hidden'>
                  {%- if product.selected_or_first_available_variant.available -%}
                    Add to cart
                  {%- else -%}
                    Sold out
                  {%- endif -%}
                </span>
                <span class='hidden in-[[processing]]:block in-[[processing]]:cursor-not-allowed'>
                  Adding to cart...
                </span>
              </button>

              {% comment %}
              {%- if product.selected_or_first_available_variant.available -%}
                <button
                  type='button'
                  class='w-full h-12 px-6 text-white bg-indigo-900 flex items-center justify-center hover:after:border-offset-1'
                  onclick='onBuyNowClicked()'
                >
                  Buy it now
                </button>
                <script>
                  const onBuyNowClicked = () => {
                    window.location.href = `/cart/${window?.prodify?.currentVariant?.id}:1`
                  }
                </script>
              {%- endif -%}

              {{ form | payment_button }}
              {% endcomment %}


              {% else %}
              <!-- all others, get a quote on price -->
                <a href="/pages/contact-us?product={{ product.title | url_encode }}" class="mt-1 rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:bg-gradient-to-r hover:from-gold-400 hover:via-gold-200 hover:to-gold-400 transition delay-150">Contact for pricing&nbsp;<span aria-hidden="true">→</span></a>
              {% endif %}

            </div>
            <div data-ajax-cart-errors='form' class='text-red-500'>
              <!-- Error messages appear here -->
            </div>


          </form>
        </ajax-cart-product-form>

        {% comment %} {% for block in section.blocks %}
          <div class='collapsable-row border border-gray-500 my-4 p-4'>
            <h2>{{ block.settings.heading }}</h2>
            <div>{{ block.settings.content }}</div>
          </div>
        {% endfor %} {% endcomment %}
      </div>
    </div>
  </div>
</div>
