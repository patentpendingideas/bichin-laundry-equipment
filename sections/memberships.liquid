	<div class="bg-gray-100 py-24 px-25 max-w-full mx-auto">
		{% if section.settings.heading != blank %}
			<h3 class="mb-12 mt-50 max-w-max mx-auto text-gold-600 font-bold text-center text-lg md:text-xl lg:text-2xl uppercase">
				{{ section.settings.heading }}
			</h3>
		{% endif %}

		{% if section.blocks.size > 0 %}
				<div class="flex flex-row justify-center items-start flex-wrap gap-8">
					{% for block in section.blocks %}
						{% if block.settings.logo != blank %}
							<div class="basis-1/3">
								{% if block.settings.logo_link != blank %}
									<a href="{{ block.settings.logo_link }}">
										{{ block.settings.logo | image_url: width: 400 | image_tag: alt: block.settings.logo.alt, loading: 'lazy' }}
									</a>
								{% endif %}
							</div>
						{% endif %}
					{% endfor %}
				</div>
		{% endif %}

	</div>

{%- schema -%}
		{
			"name": "Bichin Memberships",
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"label": "Heading"
				}
			],
			"blocks": [
				{
					"type": "associations",
					"name": "Membership",
					"settings": [
						{
							"type": "image_picker",
							"id": "logo",
							"label": "Image"
						},
						{
							"type": "url",
							"id": "logo_link",
							"label": "Logo link"
						}
					]
				}
			],
			"presets": [
				{
					"name": "Bichin Memberships"
				}
			]
		}
{%- endschema -%}