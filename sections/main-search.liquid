{% schema %}
{
  "name": "Search Section",
  "class": "section-main-search",
  "tag": "section",
  "settings": []
}
{% endschema %}

{% comment %}
  Docs on the Shopify search object
  https://shopify.dev/api/liquid/objects/search#search-results
{% endcomment %}


<div
  x-data="{
    query: '',
    results: [],
    loading: false,
    open: false,
    async search() {
      if (this.query.length < 2) {
        this.results = [];
        this.open = false;
        return;
      }
      this.loading = true;
      this.open = true;
      try {
        const res = await fetch(`/search/suggest.json?q=${encodeURIComponent(this.query)}&resources[type]=product&resources[limit]=5`);
        const data = await res.json();
        this.results = data.resources.results.products;
      } catch (e) {
        this.results = [];
      } finally {
        this.loading = false;
      }
    }
  }"
  @click.away="open = false"
  class="relative max-w-xl mx-auto mt-10 mb-15 min-h-80"
>
  {% if search.performed %}
    <h1 class="text-3xl text-center my-10 text-gray-500">Search Results</h1>
  {% else %}
    <h1 class="text-3xl text-center my-10 text-gray-500">Search</h1>
  {% endif %}

  <!-- Search Input Form -->
  <form action="/search" method="get" class="relative flex items-center">
    <input
      type="text"
      name="q"
      x-model="query"
      @input.debounce.300ms="search()"
      @focus="if(query.length >= 2) open = true"
      placeholder="Search products..."
      class="w-full py-3 pl-4 pr-12 text-gray-900 bg-white border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent shadow-sm text-sm"
    >
    <input type="hidden" name="type" value="product">
    <button type="submit" class="absolute right-3 p-2 text-gray-500 hover:text-black">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </button>
  </form>

  <!-- Dropdown Results -->
  <div
    x-show="open && (results.length > 0 || loading)"
    x-transition.opacity
    class="absolute left-0 right-0 mt-2 bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden z-50"
    style="display: none;"
  >
    <!-- Loading State -->
    <div x-show="loading" class="p-4 text-center text-sm text-gray-500">
      Searching...
    </div>

    <!-- Product Results List -->
    <template x-for="product in results" :key="product.id">
      <a :href="product.url" class="flex items-center gap-4 p-3 hover:bg-gray-50 border-b border-gray-100 last:border-none">
        <img :src="product.image" :alt="product.title" class="w-12 h-12 object-cover rounded">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-medium text-gray-900 truncate" x-text="product.title"></p>
          <!-- <p class="text-xs text-gray-500" x-text="product.price"></p> -->
        </div>
      </a>
    </template>

    <!-- View All Results Link -->
    <div x-show="results.length > 0" class="p-3 bg-gray-50 text-center border-t border-gray-100">
      <a :href="`/search?q=${encodeURIComponent(query)}&type=product`" class="text-xs font-semibold text-black hover:underline">
        View all results &rarr;
      </a>
    </div>
  </div>
</div>
