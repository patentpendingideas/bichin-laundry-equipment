  <div class="px-6 md:px-8 py-12 {{ section.settings.section_width }}">
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}">
      <div class="rich-text__blocks">
          {% if section.settings.caption != blank %}
          <div class="rich-text__caption theme_main_subheading {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">

            <h3 class="mb-12 max-w-max mx-auto color-black text-center text-md md:text-lg lg:text-xl italic">{{ section.settings.caption | escape }}</h3>

          </div>
          {% endif %}
          {% if section.settings.heading != blank %}
          <h3 class="mb-12 max-w-max mx-auto color-black text-center text-md md:text-lg lg:text-xl uppercase">
            {{ section.settings.heading }}
          </h3>
          {% endif %}
            {% if section.settings.text != blank %}

            <p class="text-center text-sm md:text-md lg:text-lg">
              {{ section.settings.text }}
            </p>
           {% endif %}

           <div class="px-6 md:px-8 py-12 mx-auto text-center">
             <a {% if section.settings.button_link == blank %} role="link" aria-disabled="true" {% else %} href="{{ section.settings.button_link }}" {% endif %} class="mt-15 text-center rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm font-semibold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:bg-gradient-to-r hover:from-gold-400 hover:via-gold-200 hover:to-gold-400 transition delay-150">
                {{- section.settings.button_label | escape -}}
              </a>
           </div>
      </div>
    </div>
  </div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
      {
        "type": "select",
        "id": "section_width",
        "options": [
          {
            "value": "max-w-full",
            "label": "Full width"
          },
          {
            "value": "max-w-4xl",
            "label": "Page width"
          }
        ],
        "label": "Section width",
        "default": "max-w-4xl"
     },
    {
      "type": "text",
      "id": "caption",
      "default": "Add a tagline",
      "label": "caption"
    },
    {
      "type": "textarea",
      "id": "heading",
      "default": "Talk about your brand",
      "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
    },
    {
      "type": "textarea",
      "id": "text",
      "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
      "label": "t:sections.rich-text.blocks.text.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:sections.image-with-text.blocks.button.settings.button_label.label",
      "info": "t:sections.rich-text.blocks.buttons.settings.button_label_1.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image-with-text.blocks.button.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name"
    }
  ]
}
{% endschema %}
