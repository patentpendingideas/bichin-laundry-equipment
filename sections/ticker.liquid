<div
	id='site-promo-bar-wrapper'
	{% if settings.collapse_promo_bar %}
		x-data
		x-show='$store.global.isPromoBarVisible'
		x-collapse
	{% endif %}
>
	<div
		id='site-promo-bar'
		class='flex px-4 py-1 top-0 w-full items-center justify-center bg-gradient-to-br from-gold-400 to-gold-600 text-white'
	>
		{% for block in section.blocks %}
			{%- case block.type -%}
				{%- when 'ticker' -%}
					<div {{ block.shopify_attributes }}>
						{% if block.settings.ticker_text != blank %}
						<div class='text-white [&_a]:text-white font-bold text-base tracking-wide text-center'>
							{{ block.settings.ticker_text }}
						</div>
						{% endif %}
					</div>
			{%- endcase -%}
		{% endfor %}
		</div>
	</div>

{% for block in section.blocks %}
	{%- case block.type -%}
		{%- when 'ticker' -%}
			<div {{ block.shopify_attributes }}>
				{% if block.settings.ticker_text != blank %}
				{{ block.settings.ticker_text }}
				{% endif %}
			</div>
	{%- endcase -%}
{% endfor %}


{% schema %}
	{
		"name": "Ticker Bar",
		"tag": "section",
		"limit": 1,
		"blocks": [
			{
				"type": "ticker",
				"name": "Ticker Title",
				"limit": 3,
				"settings": [
					{
						"type": "inline_richtext",
						"id": "ticker_text",
						"label": "Inline rich text",
						"default": "🔥 Get in touch today!"
					}
				]
			}
		],
		"presets": [
			{
				"name": "Page Ticker"
			}
		]
	}
{% endschema %}