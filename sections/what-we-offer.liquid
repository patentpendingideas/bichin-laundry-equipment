
<div class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-7xl lg:mx-0">
        {%- if section.settings.subtitle != blank -%}
         <h2 class="text-xl font-semibold tracking-tight text-pretty text-gold-600 text-center sm:text-xl md:text-2xl lg:text-2xl">{{ section.settings.subtitle }}</h2>
        {% endif %}
        {%- if section.settings.title != blank -%}
         <h2 class="text-2xl font-semibold tracking-tight text-pretty text-gold-600 text-center sm:text-xl md:text-2xl lg:text-2xl">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="mt-6 text-lg/8 text-gray-600">{{ section.settings.description }}</p>
        {% endif %}
    </div>
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
      {% for block in section.blocks %}
        <div class="flex flex-col">
        <dt class="text-base font-semibold text-gray-900">
          <div class="mb-6 flex items-center justify-center rounded-lg">
            {% if block.settings.shipping_icon != blank %}
             {{ block.settings.shipping_icon | image_url: width: 75 | image_tag : loading: 'lazy', class: 'mix-blend-multiply' }}
             {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder w-75 h-0' }}
            {% endif %}
          </div>
          {% if block.settings.shipping_heading != blank %}
            <h3 class="text-lg text-gold-400 font-bold text-center">{{ block.settings.shipping_heading }}</h3>
          {% endif %}
        </dt>
        <dd class="mt-1 flex flex-auto flex-col text-base text-gray-600 text-center">
          {% if block.settings.shipping_paragraph != blank %}
            <p class="flex-auto text-bold text-base">{{ block.settings.shipping_paragraph }}</p>
          {% endif %}

          {% if block.settings.shipping_button != blank %}
            <p class="mt-6">
              <a href="#" class="text-sm/6 font-semibold text-indigo-600 hover:text-indigo-500">{{ block.settings.shipping_button }} Learn more <span aria-hidden="true">→</span></a>
            </p>
          {% endif %}
        </dd>
      </div>
    {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "What We Offer",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Title",
      "default": "Text about your branding"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Description under the title, if you want to enter one."
    }
  ],
  "blocks": [
    {
      "type": "shipping",
      "name": "t:sections.social_media_collage.settings.service",
      "settings": [
        {
          "type": "image_picker",
          "id": "shipping_icon",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "textarea",
          "id": "shipping_heading",
          "default": "Shipping heading",
          "label": "t:sections.featured-collection.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "shipping_paragraph",
          "default": "Shipping content",
          "label": "t:sections.featured-collection.settings.description.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping section",
      "blocks": [
        {
          "type": "shipping"
        },
        {
          "type": "shipping"
        },
        {
          "type": "shipping"
        }
      ]
    }
  ]
}
{% endschema %}