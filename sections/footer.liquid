      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>

            <h3 class="text-sm/6 font-semibold text-gray-900">Helpful Links</h3>

            <ul role="list" class='mt-6 space-y-4">
              {% for link in linklists['main-menu'].links %}
                <li>
                  <a
                    href='{{ link.url }}'
                    class='text-sm/6 text-gray-600 hover:text-gray-900 no-underline{% if link.active %} underline{% endif %}'
                  >
                    {{ link.title | escape }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm/6 font-semibold text-gray-900">Customer Support</h3>

          </div>
        </div>

          <div class="mt-10 md:mt-0">
            <h3 class="text-sm/6 font-semibold text-gray-900">Contact Info</h3>

            <dl class="mt-10 space-y-4 text-base/7 text-gray-600">
              <div class="flex gap-x-4">
                <dt class="flex-none">
                  <span class="sr-only">Address</span>
