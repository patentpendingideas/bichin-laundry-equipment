<div class='px-6 md:px-8 pt-6 pb-5 mt-15 max-w-5xl mx-auto items-center'>
  <h2 class='mb-12 max-w-max mx-auto color-black text-center text-lg md:text-xl lg:text-2xl'>
    {{ collection.title }}
  </h2>
    <p class="text-lg text-center">{{ collection.description }}</p>
</div>

<div class='px-6 md:px-8 py-6 max-w-full lg:max-w-7/8 mx-auto'>
  {%- paginate collection.products by 12 -%}
    <div class='product-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-4 gap-4 gap-y-16 mx-auto items-center'>
      {% for prod in collection.products %}
        {% render 'product-grid-item-smaller', prod: prod %}
      {% endfor %}
    </div>
    {% comment %} <div class='mt-10 [&_.pagination]:mx-auto [&_.pagination]:flex [&_.pagination]:max-w-max [&_.pagination]:gap-2.5'>
      {% render 'pagination-navigation', paginate: paginate %}
    </div> {% endcomment %}
  {% endpaginate %}
</div>


{% schema %}
{
  "name": "Laundry Chemicals",
  "class": "section-main-collection",
  "tag": "section"
}
{% endschema %}