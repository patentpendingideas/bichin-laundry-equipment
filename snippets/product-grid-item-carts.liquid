{% comment %}
  Usage:
  {% render 'product-grid-item',
    prod: {product object}
  %}
{% endcomment %}

<div class='group relative flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white p-5 hover:shadow-lg transition-all ease-in-out duration-500'>
  <div class='block image-wrapper relative pt-[140%]'>
  <a href='{{ prod.url }}'>
    <img
      width='{{ prod.featured_image.width }}'
      height='{{ prod.featured_image.height }}'
      src='{{ prod.featured_image | image_url: width: 410 }}'
      srcset='{{ prod.featured_image | image_url: width: 205 }} 1x, {{ prod.featured_image | image_url: width: 410 }} 2x'
      alt='{{ prod.featured_image.alt }}'
      class='absolute inset-0 object-contain h-full hover:opacity-50 transiton ease-in-out duration-500'
      loading='lazy'
    >
  </a>
  </div>
     <a href='{{ prod.url }}'>
      <div class='text-sm font-bold text-center text-gray-900 mt-2 group-hover:underline hover:text-cloud-burst-300'>
        {{ prod.title }}
      </div>
    </a>
   <a href='{{ prod.url }}'
   class="mt-5 rounded-md bg-gold-600 bg-gradient-to-r from-gold-100 via-gold-600 to-gold-100 px-3 py-2 text-sm text-center font-bold text-white shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 hover:bg-gradient-to-r hover:from-gold-400 hover:via-gold-200 hover:to-gold-400 transition delay-150"
   >
     Contact for pricing
   </a>
    {% comment %} <p class='flex flex-wrap items-center space-x-1 *:whitespace-nowrap'>
      {% if prod.price_varies %}
        <span class='text-sm'> From </span>
      {% endif %}
      <span class='text-sm'>
        {{ prod.price | money_with_currency }}
      </span>
      {% if prod.compare_at_price_max != blank and prod.compare_at_price_max > prod.price %}
        <s class='text-sm'>{{ prod.compare_at_price_max | money_with_currency }}</s>
      {% endif %}
    </p> {% endcomment %}

  {% comment %} <ajax-cart-product-form>
    {% form 'product', prod %}
      <input type='hidden' name='id' value='{{ prod.selected_or_first_available_variant.id }}'>
      <input type='hidden' name='quantity' value='1'>
      <input type='submit' value='Add to cart'>
      <div data-ajax-cart-messages='form'>
        <!-- Error messages appear here -->
      </div>
    {% endform %}
  </ajax-cart-product-form> {% endcomment %}
</div>
