<nav
  x-data="{ openIndex: null }"
  @keydown.escape.window="openIndex = null"
  @click.stop="open = ! openIndex"
  @mouseenter="open = true" @mouseleave="open = false"
  class="relative"
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 header-menu flex items-center p-4 max-[576px]:hidden">
    <ul class="flex items-center gap-1">
      {% for link in linklists['main-menu'].links %}
        <li
          class="relative"
          @mouseenter="if (link.links.size > 0) openIndex = {{ forloop.index0 }}"
          @mouseleave="openIndex = null"
        >
          {% if link.links.size > 0 %}
            {% comment %} Item with dropdown {% endcomment %}
            <button
              type="button"
              @click="openIndex = openIndex === {{ forloop.index0 }} ? null : {{ forloop.index0 }}"
              @click.outside="openIndex = true"
              class="flex items-center gap-1 px-4 py-3 text-sm font-medium text-white hover:text-gray-500 transition-colors"
              :class="{ 'text-gray-900': openIndex === {{ forloop.index0 }} }"
              :aria-expanded="openIndex === {{ forloop.index0 }}"
            >
              {{ link.title }}
              <svg
                class="w-4 h-4 transition-transform duration-200"
                :class="{ 'rotate-180': openIndex === {{ forloop.index0 }} }"
                fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div
              x-show="openIndex === {{ forloop.index0 }}"
              x-transition:enter="transition ease-out duration-250"
              x-transition:enter-start="opacity-0 -translate-y-1"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-1"
              class="absolute left-0 top-full z-50 mt-0 min-w-[220px] rounded-lg bg-gray-500 py-2 px-4 shadow-lg outline-1 outline-gray-200/5 dark:bg-gray-500 dark:shadow-none dark:-outline-offset-1 dark:outline-white/10"
              style="display: none;"
              @click.stop
            >
              {% for child_link in link.links %}
                <a
                  href="{{ child_link.url }}"
                  class="block px-4 py-2 text-sm text-white hover:bg-gray-400 hover:rounded-md hover:text-gray-900"
                >
                  {{ child_link.title }}
                </a>
              {% endfor %}
            </div>

          {% else %}
            {% comment %} Simple link, no dropdown {% endcomment %}
            <a
              href="{{ link.url }}"
              class="block px-4 py-3 text-sm font-medium text-white hover:text-gray-900 transition-colors"
            >
              {{ link.title }}
            </a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</nav>
